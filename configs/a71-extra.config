# Minimal extra config on top of the postmarketOS SM7150 config
# (src/pmaports/.../config-postmarketos-qcom-sm7150.aarch64), the known-good
# base for this SoC.
CONFIG_LOCALVERSION="-a71"

# Console: DT bootargs are injected by scripts/build-kernel.sh, but keep a
# built-in fallback in case the bootloader drops /chosen/bootargs.
CONFIG_CMDLINE="console=tty0 console=ttyMSM0,115200n8 consoleblank=0 loglevel=7"
CONFIG_CMDLINE_EXTEND=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Faster builds; this is not a debug build.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Keep the bootloader's framebuffer alive for a text console: DRM/MSM would
# take over the display (and its panel driver is a module we do not ship),
# leaving no console at all.
# CONFIG_DRM_MSM is not set
