# configs/a71-proposed.config
#
# PROPOSITION - non appliquee, non fusionnee, non compilee.
# Differences minimales par rapport a la base vendue
# (configs/upstream/pmaports-sm7150.config). Tout symbole cite ici existe dans
# le noyau epingle 5d80fcdbbb3fbf399d3db66b0f14497d11c9489a (verification
# enregistree dans configs/a71-symbols-verified.txt).
#
# Ce fragment ne recopie PAS la base : seules les differences necessaires au
# Galaxy A71 et a la politique de demarrage retenue y figurent.

# --- identite du noyau -----------------------------------------------------
# La base porte "-sm7150" ; le projet attend la release 6.18.0-rc1-a71+
# (manifeste : kernel.expected_release).
CONFIG_LOCALVERSION="-a71"

# --- console de secours ----------------------------------------------------
# Les bootargs DT sont injectes par le pipeline, mais on garde un repli
# integre si le bootloader ne fournit pas /chosen/bootargs.
# ATTENTION : CONFIG_CMDLINE_EXTEND n'existe PAS sur arm64 dans le noyau
# epingle (arm64 utilise un choix CMDLINE_FROM_BOOTLOADER / CMDLINE_FORCE).
# Avec CMDLINE non vide, le choix s'active et CMDLINE_FROM_BOOTLOADER est le
# defaut : le bootloader prime, la chaine ci-dessous sert de repli. C'est
# exactement le comportement voulu, sans symbole inexistant.
CONFIG_CMDLINE="console=tty0 console=ttyMSM0,115200n8 consoleblank=0 loglevel=7"

# --- affichage au demarrage ------------------------------------------------
# Le DTS A71 declare un framebuffer fourni par le bootloader :
#   framebuffer@9c000000 { compatible = "simple-framebuffer"; ... }
# (arch/arm64/boot/dts/qcom/sm7150-samsung-a715f.dts, ligne 66).
# DRM_SIMPLEDRM fournit /dev/fb0 et la console texte depuis ce framebuffer.
CONFIG_DRM_SIMPLEDRM=y

# MSM n'est PAS desactive : il passe en module, disponible APRES montage.
# Justification : le DTS A71 ne declare aucun noeud de panneau DSI ; MSM ne
# peut donc rien afficher, et charge au demarrage il retirerait simpledrm
# (conflit d'aperture), supprimant la console. En module, il reste disponible
# pour la suite (bring-up DSI) sans casser la console de demarrage.
CONFIG_DRM_MSM=m

# --- taille et reproductibilite du build -----------------------------------
# La base active les informations de debogage ; on ne construit pas un noyau
# de debogage.
CONFIG_DEBUG_INFO_NONE=y

# --- pilote de panneau sans rapport avec le A71 : desactive ------------------
# DRM_PANEL_HUAXING_NT36672C (panneau Xiaomi/autre) appelle
# drm_dsc_pps_payload_pack(), fourni par drivers/gpu/drm/display/drm_dsc_helper.c
# (CONFIG_DRM_DSC_HELPER), mais son entree Kconfig ne fait PAS
# "select DRM_DSC_HELPER". Resultat observe : echec de lien vmlinux
#   panel-huaxing-nt36672c.c: undefined reference to `drm_dsc_pps_payload_pack'
# Le DTS du A71 ne reference aucun panneau : ce pilote est inutile ici.
# CONFIG_DRM_PANEL_HUAXING_NT36672C is not set

# --- options volontairement ABSENTES de ce fragment ------------------------
# Deja conformes dans la base vendue, donc non repetees (fragment minimal) :
#   CONFIG_VT, CONFIG_VT_CONSOLE, CONFIG_FRAMEBUFFER_CONSOLE   (console)
#   CONFIG_IKCONFIG, CONFIG_IKCONFIG_PROC                      (traçabilite)
#   CONFIG_MMC_SDHCI_MSM, CONFIG_EXT4_FS, CONFIG_BLK_DEV_INITRD,
#   CONFIG_DEVTMPFS                                            (stockage)
#   CONFIG_USB_DWC3, CONFIG_USB_CONFIGFS, CONFIG_USB_CONFIGFS_RNDIS,
#   CONFIG_USB_CONFIGFS_ECM                                    (reseau USB)
# Ces exigences sont verifiees apres fusion via
# configs/a71-required-symbols.txt, pas en les recopiant ici.
#
# Non retenus (justification detaillee dans docs/KERNEL_CONFIG.md) :
#   CONFIG_DRM_PANEL_SAMSUNG_S6E3FA9_AMB667UM06 : le DTS A71 n'instancie aucun
#       panneau ; le pilote existe mais aucun noeud ne le refere.
#   CONFIG_REGULATOR_QCOM_REFGEN : consomme uniquement par les controleurs DSI
#       (refgen-supply dans sm7150.dtsi), donc inutile sans DSI actif.
#   CONFIG_PHY_QCOM_QMP_COMBO : le DTS A71 limite l'USB au high-speed
#       (maximum-speed = "high-speed", UTMI), le combo PHY USB3/DP n'est pas requis.
#   CONFIG_TYPEC_QCOM_PMIC : deja =m dans la base ; suffisant apres montage.
