#!/bin/sh
# wifi-connect - join a Wi-Fi network (WPA2/WPA3-PSK or open).
#
#   wifi-connect "MySSID" "myPassword"
#   wifi-connect "OpenCafe"
#
# The configuration is written to /etc/wpa_supplicant/wpa_supplicant.conf.
# This root filesystem lives in RAM: the file is lost on reboot, re-run the
# command after a reboot (or rebuild the image with the config baked in).
set -e

SSID="$1"
PSK="$2"

if [ -z "$SSID" ]; then
    echo "usage: wifi-connect <SSID> [password]" >&2
    exit 1
fi

mkdir -p /etc/wpa_supplicant
CONF=/etc/wpa_supplicant/wpa_supplicant.conf

if [ -n "$PSK" ]; then
    wpa_passphrase "$SSID" "$PSK" > "$CONF"
    chmod 600 "$CONF"
else
    printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$SSID" > "$CONF"
fi

ip link set wlan0 up 2>/dev/null || true
pkill -x wpa_supplicant 2>/dev/null || true
sleep 1

if ! wpa_supplicant -B -i wlan0 -c "$CONF" -D nl80211; then
    wpa_supplicant -B -i wlan0 -c "$CONF" -D wext
fi

# wait for the association, then get a lease
i=0
while [ $i -lt 30 ]; do
    iw dev wlan0 link 2>/dev/null | grep -q "Connected to" && break
    i=$((i + 1))
    sleep 1
done

if command -v dhcpcd >/dev/null 2>&1; then
    dhcpcd -n wlan0 || true
else
    udhcpc -i wlan0 -q -n -t 5
fi

echo
echo "wlan0:"
ip -4 addr show dev wlan0 2>/dev/null | grep inet || echo "  no IPv4 address yet"
ip route show default 2>/dev/null
